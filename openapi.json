              "YES_NO"
            ],
            "title": "Question Type"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/DraftQuestionOptionRequest"
            },
            "type": "array",
            "title": "Options"
          },
          "recommendation": {
            "$ref": "#/components/schemas/DraftRecommendationRequest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question_id",
          "text",
          "question_type",
          "options",
          "recommendation"
        ],
        "title": "DraftQuestionRequest"
      },
      "DraftRecommendationRequest": {
        "properties": {
