            "type": "string",
            "enum": [
              "OPEN",
              "PROPOSED",
              "OWNER_SELECTED",
              "SYNTHESIZED",
              "TESTED",
              "RATIFIED",
              "UNRESOLVED",
              "SUPERSEDED"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "proposed_answer",
          "reason",
          "status"
        ],
        "title": "DraftRecommendationRequest"
      },
      "DraftRequest": {
        "properties": {
          "draft": {
            "$ref": "#/components/schemas/DraftRoundRequest"
          }
        },
        "additionalProperties": false,
        "type": "object",
