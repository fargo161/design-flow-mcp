  "components": {
    "schemas": {
      "CreateProjectRequest": {
        "properties": {
          "display_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Display Name"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "DISCOVERY"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "title": "Description",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "display_name"
        ],
        "title": "CreateProjectRequest"
      },
      "DraftConceptRequest": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "REGISTER",
              "REVISE"
            ],
            "title": "Action"
          },
          "concept_id": {
            "type": "string",
            "title": "Concept Id"
          },
          "canonical_name": {
            "type": "string",
            "title": "Canonical Name"
          },
          "definition": {
            "type": "string",
            "title": "Definition"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "maturity": {
            "type": "string",
            "enum": [
              "PROPOSED",
              "DEFINED",
              "TESTED",
              "STABLE",
              "DISPUTED",
              "DEPRECATED"
            ],
            "title": "Maturity"
          },
          "owns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Owns"
          },
          "does_not_own": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Does Not Own"
          },
          "boundaries": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Boundaries"
          },
          "dependencies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dependencies"
          },
          "relations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Relations"
          },
          "unresolved": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unresolved"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "concept_id",
          "canonical_name",
          "definition",
          "version",
          "maturity",
          "owns",
          "does_not_own",
          "boundaries",
          "dependencies",
          "relations",
          "unresolved"
        ],
        "title": "DraftConceptRequest"
      },
      "DraftDecisionRequest": {
        "properties": {
          "question_id": {
            "type": "string",
            "title": "Question Id"
          },
          "decision_id": {
            "type": "string",
            "title": "Decision Id"
          },
          "scope": {
            "type": "string",
            "title": "Scope"
          },
          "rule_mapping": {
            "items": {
              "$ref": "#/components/schemas/DraftRuleMappingRequest"
            },
            "type": "array",
            "title": "Rule Mapping"
          },
          "dependencies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dependencies"
          },
          "unresolved_consequences": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unresolved Consequences"
          },
          "supersedes_decision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supersedes Decision"
          },
          "supersession_notes": {
            "type": "string",
            "title": "Supersession Notes"
          },
          "concept": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DraftConceptRequest"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question_id",
          "decision_id",
          "scope",
          "rule_mapping",
          "dependencies",
          "unresolved_consequences",
          "supersedes_decision",
          "supersession_notes",
          "concept"
        ],
        "title": "DraftDecisionRequest"
      },
      "DraftQuestionOptionRequest": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
