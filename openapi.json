          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid private API key"
          },
          "404": {
            "description": "Project or round not found"
          },
          "409": {
            "description": "Invalid project or draft lifecycle state"
          },
          "422": {
            "description": "Request or Design Flow validation failed"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      },
