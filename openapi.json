{
  "openapi": "3.1.0",
  "info": {
    "title": "Design Flow Action API",
    "description": "Private single-user REST adapter for Design Flow. Recommendations and previews are non-authoritative; only an explicitly approved lock commits semantic authority.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://design-flow-action-fargo161.fly.dev"
    }
  ],
